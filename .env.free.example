# Troque 203-0-113-10 pelo IP público da sua VM, usando hífens.
# O sslip.io resolve gratuitamente este endereço para o próprio IP.
SITE_HOST=votoclaro.203-0-113-10.sslip.io

# Senha usada somente entre a aplicação e o PostgreSQL dentro da VM.
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Faz a primeira importação apenas se o banco ainda estiver vazio.
SYNC_ON_START=true
SYNC_PHOTOS=true
SYNC_INTERVAL_MINUTES=360
SNAPSHOT_RETENTION=10
PHOTO_SYNC_CONCURRENCY=3

# IA local. O modelo é baixado uma única vez para o volume llm_models.
# A aplicação nunca envia o PDF a uma API externa.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LOCAL_LLM_TIMEOUT_MS=1200000
LOCAL_LLM_STARTUP_WAIT_MS=1800000
LOCAL_LLM_CHUNK_CHARACTERS=18000
LOCAL_LLM_MAX_OUTPUT_TOKENS=1600
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_PRECOMPUTE_ON_START=true
LOCAL_LLM_PRECOMPUTE_LIMIT=200

# Gere valores longos e diferentes. Nunca publique o arquivo .env.free.
SYNC_SECRET=troque-por-um-segredo-longo-e-aleatorio
CRON_SECRET=troque-por-outro-segredo-longo-e-aleatorio

INTEGRITY_TIMEOUT_MS=30000
INTEGRITY_RETRY_COUNT=1
INTEGRITY_RETRY_DELAY_MS=500
INTEGRITY_CACHE_TTL_MINUTES=360
INTEGRITY_ERROR_CACHE_TTL_SECONDS=300

# Opcional: habilita CEIS, CNEP e CEAF no Portal da Transparência.
PORTAL_TRANSPARENCIA_TOKEN=
