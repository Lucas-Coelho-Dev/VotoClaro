# Servidor
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Persistência. Sem DATABASE_URL, o desenvolvimento usa ./data apenas para dados públicos.
DATABASE_URL=postgresql://votoclaro:senha-forte@localhost:5432/votoclaro
DATABASE_SSL=false

# Atualização oficial
# Baixa somente quando o armazenamento ainda está vazio.
# Com uma base persistida, o site abre sem um novo download.
SYNC_ON_START=true
SYNC_SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=360
SNAPSHOT_REFRESH_SECONDS=30
SYNC_PHOTOS=true
PHOTO_SYNC_CONCURRENCY=3
MAX_CANDIDATE_PHOTO_BYTES=5242880
SOURCE_TIMEOUT_MS=120000
MAX_DOWNLOAD_BYTES=262144000
SNAPSHOT_RETENTION=10

# Obrigatório para acionar /api/v1/admin/sync. Na Vercel, CRON_SECRET é aceito.
SYNC_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# Em produção, prefira *_FILE com Docker Secrets em vez de valores neste arquivo.
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
# SYNC_SECRET_FILE=/run/secrets/sync_secret
# ADMIN_SECRET_FILE=/run/secrets/admin_secret
# PORTAL_TRANSPARENCIA_TOKEN_FILE=/run/secrets/portal_transparencia_token
# DATAJUD_API_KEY_FILE=/run/secrets/datajud_api_key
# GOOGLE_FACT_CHECK_API_KEY_FILE=/run/secrets/google_fact_check_api_key

API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
HEAVY_RATE_LIMIT_MAX=60
ADMIN_RATE_LIMIT_MAX=10

# Fiscalização oficial. TCU funciona sem chave. Para CEIS, CNEP e CEAF,
# solicite gratuitamente a chave da API do Portal da Transparência e mantenha-a só no servidor.
INTEGRITY_TIMEOUT_MS=30000
INTEGRITY_RETRY_COUNT=1
INTEGRITY_RETRY_DELAY_MS=500
INTEGRITY_CACHE_TTL_MINUTES=360
INTEGRITY_ERROR_CACHE_TTL_SECONDS=300
INTEGRITY_MAX_RESPONSE_BYTES=1048576
PORTAL_TRANSPARENCIA_TOKEN=
DATAJUD_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
FACT_CHECK_MAX_AGE_DAYS=2920
FACT_CHECK_PAGE_SIZE=10
IDENTITY_VAULT_REFRESH_ON_START=true

# Conector opcional futuro
GOOGLE_FACT_CHECK_API_KEY=

# IA local opcional. Em desenvolvimento, mantenha desabilitada se o llama.cpp
# não estiver rodando em http://localhost:8080/v1.
LOCAL_LLM_ENABLED=false
AI_WORKER_AVAILABLE=false
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen3-1.7b-local
LOCAL_LLM_TIMEOUT_MS=600000
LOCAL_LLM_STARTUP_WAIT_MS=1800000
LOCAL_LLM_CHUNK_CHARACTERS=18000
LOCAL_LLM_MAX_OUTPUT_TOKENS=1100
LOCAL_LLM_TEMPERATURE=0.1
BACKGROUND_ANALYSIS_ENABLED=true
LOCAL_LLM_PRECOMPUTE_LIMIT=500
LOCAL_LLM_LEGISLATIVE_PRECOMPUTE_LIMIT=500
AI_WORKER_INTERVAL_MINUTES=30
